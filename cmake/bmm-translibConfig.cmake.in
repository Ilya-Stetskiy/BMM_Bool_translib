@PACKAGE_INIT@

# bmm-translibConfig.cmake — потребляется downstream-проектом через
# find_package(bmm-translib REQUIRED) + target_link_libraries(... bmm::bmm_aig
# bmm::bmm_bdd ...) (см. README.md/CMakeLists.txt "install()/export()" за
# полным объяснением, что именно экспортируется).
#
# ЧЕСТНАЯ ОГОВОРКА (см. тот же комментарий в CMakeLists.txt): Sylvan/BRiAl/
# mockturtle подключены в bmm_core через find_path/find_library с
# АБСОЛЮТНЫМИ путями (у них самих нет собственного CMake-пакета в этом
# окружении) — они уже "запечены" в bmm-translibTargets.cmake как есть, тут
# заново find_dependency их не делаем и не можем (нечего find_package'ить).
# Поэтому этот Config.cmake воспроизводимо работает на машине с ТЕМ ЖЕ
# layout зависимостей (тот же Docker-образ genetica-boolean-lib или его
# копия), а не как полностью релокейтабл-пакет в общем смысле CMake.
#
# Threads — единственная транзитивная зависимость bmm_core, у которой
# действительно есть собственный стандартный CMake-модуль, поэтому она
# find_dependency, а не запечённый абсолютный путь.

include(CMakeFindDependencyMacro)
find_dependency(Threads REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/bmm-translibTargets.cmake")

check_required_components(bmm-translib)
